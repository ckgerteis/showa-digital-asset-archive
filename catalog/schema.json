{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ckgerteis.github.io/showa-digital-asset-archive/catalog/schema.json",
  "title": "Shōwa Digital Asset Archive catalog entry (schema v2)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "source", "source_url", "creator", "licence", "period_tags", "object_tags",
                 "showa_fit", "verification"],
    "properties": {
      "id": {"type": "string", "pattern": "^(skf|fab|cgt|unity)-[0-9]{4}$"},
      "title": {"type": "string", "minLength": 1, "description": "Title as given on the listing"},
      "title_ja": {"type": "string", "description": "Japanese object name; every character verified before entry"},
      "source": {"enum": ["sketchfab", "fab", "cgtrader", "unity_asset_store"]},
      "source_url": {"type": "string", "pattern": "^https://(sketchfab\\.com/3d-models/|www\\.fab\\.com/listings/|www\\.cgtrader\\.com/|assetstore\\.unity\\.com/packages/)"},
      "creator": {"type": "string", "minLength": 1, "not": {"enum": ["Generic", "Unknown", "Various"]},
                  "description": "Creator or seller as named on the listing; 'Not confirmed' if the listing could not be read"},
      "creator_url": {"type": "string", "format": "uri"},
      "licence": {"type": "string", "minLength": 1, "description": "Licence as stated on the listing"},
      "period_tags": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": {"enum": ["interwar_wartime_1926_1945", "occupation_reconstruction_1945_1952",
                           "high_growth_1952_1973", "late_showa_1973_1989", "unassigned"]}
      },
      "object_tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}},
      "space_tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}},
      "historical_notes": {"type": "string"},
      "showa_fit": {"enum": ["unassessed", "documented", "proxy", "anachronistic"],
                    "description": "Curatorial judgement of historical fit; set only by the curator"},
      "review_note": {"type": "string", "description": "Open curatorial question about this entry"},
      "image": {"type": "string", "format": "uri"},
      "technical": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "faces": {"type": "integer"}, "vertices": {"type": "integer"}, "downloadable": {"type": "boolean"},
          "formats": {"type": "string"}, "price": {"type": "string"}
        }
      },
      "verification": {
        "type": "object", "additionalProperties": false, "required": ["status", "method", "checked"],
        "properties": {
          "status": {"enum": ["verified", "probable"]},
          "method": {"enum": ["sketchfab-api", "web-search", "manual"]},
          "checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
